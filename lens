var SIM_RI=[{v:1.56,l:'1.56 · 1번 압축'},{v:1.60,l:'1.60 · 2번 압축'},{v:1.67,l:'1.67 · 3번 압축'},{v:1.74,l:'1.74 · 4번 압축'}],
    SIM_SIZES=[{l:'소형 46mm',v:46},{l:'표준 50mm',v:50},{l:'대형 54mm',v:54}],
    SIM_GUESS=[{l:'얇아요',v:150},{l:'보통이에요',v:350},{l:'두꺼워요',v:600}];
var simSt={power:3,ri:1.60,size:50,CT:1.0};
var pwrR=document.getElementById('pwrR'),pwrV=document.getElementById('pwrV');
function simEdge(p,n,d,ct){var y=d/2;return ct+(y*y*p)/(2000*(n-1));}
function recommendRatio(power){
  if(power<=2.75) return 1.56;
  if(power<=3.75) return 1.60;
  if(power<=5.75) return 1.67;
  return 1.74;
}
function renderRiChips(){
  var host=document.getElementById('riChips');
  if(!host) return;
  var rec=recommendRatio(simSt.power);
  host.innerHTML=SIM_RI.map(function(r){
    var isRec=r.v===rec, active=r.v===simSt.ri;
    return '<button type="button" class="simChip'+(isRec?' rec':'')+'" aria-pressed="'+(active?'true':'false')+'" onclick="pickRi('+r.v+')">'+
      (isRec?'<span class="recBadge">추천</span>':'')+r.l+
    '</button>';
  }).join('');
}
function pickRi(v){
  simSt.ri=v;
  renderRiChips();
  simDraw();
}
function simChipset(host,arr,lbl,pick,act){
  arr.forEach(function(it){
    var b=document.createElement('button');b.className='simChip';b.type='button';
    b.textContent=lbl(it);b.setAttribute('aria-pressed',act(it)?'true':'false');
    b.addEventListener('click',function(){
      [].forEach.call(host.children,function(c){c.setAttribute('aria-pressed','false');});
      b.setAttribute('aria-pressed','true');pick(it);
    });
    host.appendChild(b);
  });
}
var SIM_CX=150,SIM_TOP=40,SIM_H=220,SIM_PX=13;
function simPathFor(et,ct){
  var e=Math.min(et,9.5)*SIM_PX,c=ct*SIM_PX,bulge=14;
  var yT=SIM_TOP,yB=SIM_TOP+SIM_H,yM=SIM_TOP+SIM_H/2,xf=SIM_CX-e/2;
  var f0=xf,fM=xf-bulge,fc=2*fM-f0,b0=xf+e,bM=fM+c,bc=2*bM-b0;
  return 'M '+f0+' '+yT+' Q '+fc+' '+yM+' '+f0+' '+yB+' L '+b0+' '+yB+' Q '+bc+' '+yM+' '+b0+' '+yT+' Z';
}
function simDraw(){
  if(!document.getElementById('lensSvg')) return;
  var et=simEdge(simSt.power,simSt.ri,simSt.size,simSt.CT),base=simEdge(simSt.power,1.56,simSt.size,simSt.CT);
  pwrV.textContent='-'+simSt.power.toFixed(2);
  document.getElementById('rdEdge').innerHTML=et.toFixed(2)+'<small>mm</small>';
  var d=document.getElementById('rdDelta');
  if(simSt.ri===1.56){d.innerHTML='기준';}
  else{var diff=base-et;d.innerHTML='-'+diff.toFixed(2)+'<small>mm · '+Math.round(diff/base*100)+'%</small>';}
  document.getElementById('lensPath').setAttribute('d',simPathFor(et,simSt.CT));
  document.getElementById('ghostPath').setAttribute('d',simSt.ri===1.56?'':simPathFor(base,simSt.CT));
  var e=Math.min(et,9.5)*SIM_PX,xf=SIM_CX-e/2,xr=xf+e;
  document.getElementById('sheenPath').setAttribute('d',
    'M '+(xf+2)+' '+(SIM_TOP+14)+' Q '+(xf-6)+' '+(SIM_TOP+70)+' '+(xf+4)+' '+(SIM_TOP+120)+
    ' L '+(xf+9)+' '+(SIM_TOP+118)+' Q '+(xf+1)+' '+(SIM_TOP+70)+' '+(xf+7)+' '+(SIM_TOP+16)+' Z');
  var calX=xr+46;
  var T=document.getElementById('calT'),B=document.getElementById('calB'),V=document.getElementById('calV');
  T.setAttribute('x1',xr);T.setAttribute('y1',SIM_TOP);T.setAttribute('x2',calX+8);T.setAttribute('y2',SIM_TOP);
  B.setAttribute('x1',xf);B.setAttribute('y1',SIM_TOP+18);B.setAttribute('x2',calX-8);B.setAttribute('y2',SIM_TOP+18);
  V.setAttribute('x1',calX);V.setAttribute('y1',SIM_TOP-12);V.setAttribute('x2',calX);V.setAttribute('y2',SIM_TOP+30);
  var L=document.getElementById('calLbl');
  L.setAttribute('x',calX+14);L.setAttribute('y',SIM_TOP+14);L.textContent=et.toFixed(2)+' mm';
  var G=document.getElementById('ghostLbl');
  if(simSt.ri===1.56){G.textContent='';}
  else{var bp=Math.min(base,9.5)*SIM_PX;G.setAttribute('x',SIM_CX-bp/2-76);G.setAttribute('y',SIM_TOP+SIM_H+18);
    G.textContent='1.56  '+base.toFixed(2)+'mm';}
}
if(document.getElementById('riChips')){
  renderRiChips();
  simChipset(document.getElementById('sizeChips'),SIM_SIZES,function(s){return s.l;},function(s){simSt.size=s.v;simDraw();},function(s){return s.v===simSt.size;});
  simChipset(document.getElementById('guessChips'),SIM_GUESS,function(g){return g.l;},function(g){pwrR.value=g.v;simSt.power=g.v/100;simSt.ri=recommendRatio(simSt.power);renderRiChips();simDraw();},function(){return false;});
