<title>다비치 렌즈 가이드</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap">
<style>
/* ---------- tokens ---------- */
:root{
  --ink:#12151c;
  --paper:#f3f5fa;
  --surface:#ffffff;
  --surface-2:#eaeff7;
  --surface-3:#e2e8f2;
  --line:#dfe5ef;
  --muted:#666f7d;
  --muted-2:#98a1b0;
  --accent:#1f3fc4;
  --accent-strong:#15308f;
  --accent-ink:#ffffff;
  --accent-soft:#e7ecff;
  --coat-a:#2454e0;
  --coat-b:#33c9a6;
  --coat-c:#8b6bf0;
  --gold:#9a6f28;
  --gold-soft:#f7ecd8;
  --danger:#c8433a;
  --shadow:0 14px 34px rgba(24,32,58,.09);
  --shadow-lg:0 24px 60px rgba(24,32,58,.16);
  --radius-lg:24px;
  --radius-md:17px;
  --radius-sm:12px;
  --font-display:'Noto Sans KR','Pretendard',-apple-system,BlinkMacSystemFont,'Malgun Gothic',sans-serif;
  --font-body:'Noto Sans KR','Pretendard',-apple-system,BlinkMacSystemFont,'Malgun Gothic',sans-serif;
  --font-mono:'JetBrains Mono',ui-monospace,'SFMono-Regular',monospace;
  --nav-h:64px;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --ink:#eef1f7;
    --paper:#0a0c11;
    --surface:#12151d;
    --surface-2:#191d27;
    --surface-3:#20242f;
    --line:#272c38;
    --muted:#9aa2b1;
    --muted-2:#5d6472;
    --accent:#7893ff;
    --accent-strong:#a9b8ff;
    --accent-ink:#0a0c11;
    --accent-soft:#1a2140;
    --gold:#dfbd7f;
    --gold-soft:#2a2114;
    --danger:#ff8079;
    --shadow:0 14px 34px rgba(0,0,0,.45);
    --shadow-lg:0 24px 60px rgba(0,0,0,.55);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --ink:#eef1f7;
  --paper:#0a0c11;
  --surface:#12151d;
  --surface-2:#191d27;
  --surface-3:#20242f;
  --line:#272c38;
  --muted:#9aa2b1;
  --muted-2:#5d6472;
  --accent:#7893ff;
  --accent-strong:#a9b8ff;
  --accent-ink:#0a0c11;
  --accent-soft:#1a2140;
  --gold:#dfbd7f;
  --gold-soft:#2a2114;
  --danger:#ff8079;
  --shadow:0 14px 34px rgba(0,0,0,.45);
  --shadow-lg:0 24px 60px rgba(0,0,0,.55);
  color-scheme:dark;
}

*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--font-body);letter-spacing:-.01em;text-rendering:optimizeLegibility}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
h1,h2,h3{font-family:var(--font-display);text-wrap:balance;margin:0}
p{margin:0}
.mono{font-family:var(--font-mono);font-variant-numeric:tabular-nums}
:focus{outline:none}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:6px}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.001ms!important;transition-duration:.001ms!important;scroll-behavior:auto!important}}

.app{max-width:460px;margin:0 auto;background:var(--surface);min-height:100vh;position:relative;box-shadow:var(--shadow-lg);display:flex;flex-direction:column}
@media(min-width:720px){body{padding:32px 0}.app{border-radius:32px;overflow:hidden;min-height:calc(100vh - 64px)}}

/* ---------- topbar ---------- */
.topbar{position:sticky;top:0;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px;background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:9px;border:0;background:none;padding:0;cursor:pointer;text-align:left}
.brand .mark{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--coat-a),var(--coat-c) 55%,var(--coat-b));display:flex;align-items:center;justify-content:center;flex:none}
.brand .mark svg{width:16px;height:16px;color:#fff}
.brand .word{font-family:var(--font-display);font-weight:800;font-size:14.5px;letter-spacing:-.2px;line-height:1.15}
.brand .word small{display:block;font-family:var(--font-body);font-weight:600;font-size:10.5px;color:var(--muted);letter-spacing:0;margin-top:1px}
.topbar-actions{display:flex;align-items:center;gap:6px}
.iconbtn{position:relative;width:38px;height:38px;border-radius:12px;border:1px solid var(--line);background:var(--surface);display:flex;align-items:center;justify-content:center;color:var(--ink)}
.iconbtn svg{width:18px;height:18px}
.iconbtn .badge{position:absolute;top:-5px;right:-5px;min-width:16px;height:16px;padding:0 4px;border-radius:99px;background:var(--danger);color:#fff;font-size:9.5px;font-weight:800;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono)}

/* ---------- screens ---------- */
.screen{display:none;flex:1;padding-bottom:calc(var(--nav-h) + 14px + env(safe-area-inset-bottom))}
.screen.active{display:block}
.hero{padding:30px 20px 24px;background:linear-gradient(180deg,var(--surface-2),var(--surface))}
.heroLead{margin-top:2px;font-size:14px;line-height:1.6;color:var(--muted)}
.heroWrap{background:linear-gradient(180deg,var(--surface-2),var(--surface))}
.heroWrap .hero{background:transparent}
.shimmer{height:3px;width:52px;border-radius:99px;background:linear-gradient(90deg,var(--coat-a),var(--coat-b),var(--coat-c));margin-bottom:14px}
.heroImgWrap{width:100%;aspect-ratio:1.15/1;margin:22px 0 6px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:transparent}
.heroImg{width:100%;height:100%;object-fit:contain;display:block}
.heroImgWrap .placeholderLabel{font-size:12px;font-weight:600;color:var(--muted-2);letter-spacing:.1px;text-align:center;line-height:1.6}
.tag{display:inline-flex;align-items:center;gap:6px;padding:7px 11px;background:var(--accent-soft);color:var(--accent-strong);border-radius:999px;font-size:12px;font-weight:800}
h1{font-size:clamp(26px,7vw,32px);line-height:1.42;letter-spacing:-.3px;margin:14px 0 12px}
h1.compact{font-size:26px}
h2{font-size:21px;line-height:1.4;letter-spacing:-.2px;margin:0 0 6px}
h3{font-size:17px;line-height:1.45;letter-spacing:-.2px}
.lead{font-size:14.5px;line-height:1.72;color:var(--muted)}
.section{padding:26px 20px;border-bottom:1px solid var(--line)}
.reveal{opacity:0;transform:translateY(26px);transition:opacity .6s cubic-bezier(.22,.61,.36,1),transform .6s cubic-bezier(.22,.61,.36,1);will-change:opacity,transform}
.reveal.in{opacity:1;transform:translateY(0)}
@media (prefers-reduced-motion: reduce){
  .reveal{opacity:1;transform:none;transition:none}
}
.section-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-bottom:14px}
.kicker{font-size:13px;font-weight:600;color:var(--ink);letter-spacing:-.1px;line-height:1.4;margin-bottom:2px}

/* ---------- flat icon boxes ---------- */
.icobox{width:38px;height:38px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex:none;background:var(--surface-2);color:var(--accent)}
.icobox svg{width:19px;height:19px}
.icobox.sm{width:30px;height:30px;border-radius:9px}
.icobox.sm svg{width:15px;height:15px}
.icobox.on-accent{background:rgba(255,255,255,.18);color:#fff}
.icobox.emoji-ico{font-family:"Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif;font-style:normal;line-height:1;filter:drop-shadow(0 2px 3px rgba(20,30,60,.18))}

/* ---------- home routes ---------- */
.routeMain{width:100%;display:flex;align-items:center;gap:14px;text-align:left;border:none;border-radius:16px;padding:18px;margin-top:14px;background:linear-gradient(135deg,#15308f,var(--coat-a) 60%,#5b93ff 120%);box-shadow:var(--shadow);cursor:pointer;transition:transform .16s ease}
.routeMain:hover{transform:translateY(-2px)}
.routeMain:active{transform:translateY(0)}
.routeMain .icobox{width:52px;height:52px;border-radius:16px}
.routeMain .icobox svg{width:26px;height:26px}
.routeMain .icobox.emoji-ico{font-size:27px}
.routeMain-body{flex:1;min-width:0}
.routeMain-tag{display:inline-block;font-size:10.5px;font-weight:800;color:rgba(255,255,255,.85);background:rgba(255,255,255,.16);padding:3px 9px;border-radius:999px;margin-bottom:8px;letter-spacing:.02em}
.routeMain-body b{display:block;font-size:16.5px;line-height:1.42;letter-spacing:-.2px;font-weight:600;color:#fff}
.routeMain-body small{display:block;color:rgba(255,255,255,.8);font-size:11.5px;line-height:1.55;margin-top:7px}
.routeMain-arrow{flex:none;width:19px;height:19px;color:rgba(255,255,255,.85)}

.routegrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.route{border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:16px 15px;text-align:left;min-height:130px;display:flex;flex-direction:column;transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease}
.route:hover{transform:translateY(-2px);border-color:var(--accent);box-shadow:var(--shadow)}
.route:active{transform:translateY(0)}
.route .icobox{margin-bottom:14px;background:transparent;width:34px;height:34px;border-radius:0}
.route .icobox svg{width:27px;height:27px}
.route .icobox.emoji-ico{font-size:26px;justify-content:flex-start}
.routeLink .icobox{background:transparent;color:var(--muted)}
.route b{display:block;font-size:14.5px;line-height:1.45;letter-spacing:-.2px;font-weight:600}
.route small{display:block;color:var(--muted);font-size:12px;line-height:1.58;margin-top:6px}

.routeLink{width:100%;display:flex;align-items:center;gap:8px;text-align:left;border:none;background:transparent;padding:2px 0;margin-top:16px;cursor:pointer;transition:opacity .16s ease}
.routeLink:hover{opacity:.7}
.routeLink-txt{flex:1;min-width:0}
.routeLink-txt b{display:inline;font-size:12.5px;font-weight:700;color:var(--muted)}
.routeLink-txt small{display:block;font-size:11.5px;color:var(--muted-2);margin-top:2px;line-height:1.5}
.routeLink-arrow{flex:none;width:13px;height:13px;color:var(--muted-2)}

.eyewidget{margin-top:18px;background:var(--surface-2);border:1px solid var(--line);border-radius:var(--radius-lg);padding:18px}
.eyewidget-title{font-size:19px;line-height:1.42;letter-spacing:-.2px;margin-top:8px}
.eyechips{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}
.eyechip{white-space:nowrap;border:1px solid var(--line);border-radius:999px;background:var(--surface);color:var(--muted);padding:8px 14px;font-size:12.5px;font-weight:800;font-family:inherit;cursor:pointer;transition:all .15s}
.eyechip:hover{border-color:var(--accent)}
.eyechip.active{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.eyestage{margin-top:14px;background:linear-gradient(165deg,var(--surface),var(--surface-3));border-radius:var(--radius-md);padding:6px 6px 14px;overflow:hidden}
.eyestage svg{display:block;width:100%;height:auto}
.eyesim{display:flex;gap:8px;margin:10px 8px 4px}
.eyesimcard{flex:1;background:var(--surface);border-radius:12px;padding:11px 8px 10px;text-align:center;box-shadow:var(--shadow)}
.eyesimk{font-size:10px;color:var(--muted-2);letter-spacing:0}
.eyesimt{font-family:var(--font-mono);font-size:18px;font-weight:700;color:var(--ink);margin:7px 0 8px;transition:filter .4s,transform .4s,text-shadow .4s;will-change:filter}
.eyesimtag{display:inline-block;font-size:10px;letter-spacing:-.01em;padding:2px 8px;border-radius:999px;background:var(--surface-2);color:var(--muted);transition:background .3s,color .3s}
.eyesimtag.blurred{background:var(--accent-soft);color:var(--accent-strong)}
.eyesimcap{margin:6px 8px 0;font-size:11.5px;color:var(--muted);text-align:center}
.eyeinfo{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-md);padding:16px;margin-top:12px}
.eyeinfo h4{margin:0 0 6px;font-size:16px;font-family:var(--font-display);font-weight:700;letter-spacing:-.2px}
.eyeinfo p{font-size:12.5px;line-height:1.58;color:var(--muted);margin:0}
.eyenote{color:var(--accent-strong)!important;background:var(--accent-soft);border-radius:10px;padding:8px 10px;margin-top:10px!important;font-size:11.5px!important;line-height:1.5!important}
.eyerow{display:flex;gap:10px;padding-top:12px;margin-top:12px;border-top:1px solid var(--line)}
.eyerow-k{flex:0 0 76px;font-size:11.5px;color:var(--muted-2);padding-top:1px}
.eyerow-v{flex:1;font-size:12.5px;line-height:1.5}
.eyerxcode{display:inline-block;background:var(--surface-2);border-radius:6px;padding:2px 7px;margin-top:3px;font-size:12px;font-family:var(--font-mono)}
.eyecta{margin-top:12px;font-size:12.5px}
.prodSwipe{display:flex;gap:14px;overflow-x:auto;margin:14px -16px 0;padding:2px 16px 4px;-webkit-overflow-scrolling:touch}
.prodCard{flex:0 0 128px}
.prodThumb{position:relative;width:128px;height:128px;border-radius:var(--radius-md);background:var(--surface-2);display:flex;align-items:center;justify-content:center}
.prodThumb svg{width:46px;height:46px;color:var(--muted-2)}
.prodBadge{position:absolute;top:8px;left:8px;background:var(--ink);color:var(--paper);font-size:9.5px;font-weight:800;padding:3px 7px;border-radius:6px;letter-spacing:.02em}
.prodBrand{font-size:10.5px;color:var(--muted-2);margin-top:10px;font-weight:600;letter-spacing:.01em}
.prodName{font-size:12px;font-weight:600;line-height:1.48;margin-top:4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.prodTag{color:var(--accent);font-weight:700}
.prodPrice{font-size:13.5px;font-weight:700;margin-top:7px}

.recent{display:flex;gap:8px;overflow:auto;margin-top:14px;padding-bottom:2px}
.recent .rchip{white-space:nowrap;border:1px dashed var(--line);border-radius:999px;background:var(--surface);padding:8px 12px;font-size:11.5px;font-weight:700;color:var(--muted)}

.chips{display:flex;gap:7px;overflow:auto;padding-bottom:3px}
.chip{white-space:nowrap;border:1px solid var(--line);border-radius:999px;background:var(--surface);padding:9px 13px;font-size:12px;font-weight:750}
.chip:hover{border-color:var(--accent)}

/* ---------- lens type cards ---------- */
.typeCard{display:flex;gap:12px;border:1px solid transparent;background:var(--accent-soft);border-radius:var(--radius-md);padding:15px}
.typeCard .icobox{background:var(--surface)}
.typeCard .body{flex:1;min-width:0}
.typeCard .cust{display:block;font-size:14.5px;font-weight:600;line-height:1.42;letter-spacing:-.1px}
.typeCard .cust .term{color:var(--accent)}
.typeCard p{font-size:12.5px;color:var(--muted);line-height:1.58;margin-top:6px}

/* ---------- dark refractive-index / thickness simulator ---------- */
.secDark{padding:28px 20px 32px;background:#0b0d12;color:#eef1f4}
.secDark .kicker{color:#8b93a7}
.secDark h2{color:#fff}
.secDark .lead{color:#aab0bd}
.simStage{background:#000;border-radius:18px;padding:8px 0 0;margin-bottom:16px;overflow:hidden}
.simStage svg{display:block;width:100%;height:auto}
.simReadout{display:flex;gap:9px;margin-bottom:10px}
.simRd{flex:1;background:#181b22;border-radius:14px;padding:13px 15px}
.simRd-k{font-size:11.5px;color:#8b93a7}
.simRd-v{font-size:24px;font-weight:800;color:#fff;margin-top:3px;font-variant-numeric:tabular-nums}
.simRd-v small{font-size:12.5px;font-weight:600;color:#8b93a7;margin-left:2px}
.simRd-delta .simRd-v{color:#8fa2ff}
.simNote{font-size:11.5px;line-height:1.6;color:#767d8c;margin:0 0 22px}
.simField{margin-bottom:20px}
.simField:last-child{margin-bottom:0}
.simField-top{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:8px}
.simField-k{font-size:13px;color:#9aa2b3;font-weight:750}
.simField-v{font-size:18px;font-weight:800;color:#fff;font-variant-numeric:tabular-nums}
.simRange{-webkit-appearance:none;appearance:none;width:100%;height:28px;background:transparent;cursor:pointer;margin:0}
.simRange::-webkit-slider-runnable-track{height:4px;border-radius:2px;background:rgba(255,255,255,.18)}
.simRange::-moz-range-track{height:4px;border-radius:2px;background:rgba(255,255,255,.18)}
.simRange::-webkit-slider-thumb{-webkit-appearance:none;width:24px;height:24px;border-radius:50%;background:#fff;margin-top:-10px;box-shadow:0 3px 8px rgba(0,0,0,.4)}
.simRange::-moz-range-thumb{width:22px;height:22px;border-radius:50%;background:#fff;border:0;box-shadow:0 3px 8px rgba(0,0,0,.4)}
.simEnds{display:flex;justify-content:space-between;font-size:11px;color:#767d8c;margin-top:-2px}
.simLinkbtn{background:none;border:0;padding:0;margin-top:10px;cursor:pointer;font-family:inherit;font-size:13.5px;font-weight:800;color:#8fa2ff}
.simGuess{border-radius:14px;padding:15px;margin-top:11px;background:#181b22}
.simGuess[hidden]{display:none}
.simGuess p{margin:0 0 11px;font-size:13px;color:#9aa2b3;line-height:1.55}
.secDark .chips{display:flex;flex-wrap:wrap;gap:6px}
.simChip{font-family:inherit;font-size:13px;font-weight:500;letter-spacing:-.01em;padding:8px 14px;border-radius:999px;cursor:pointer;border:1px solid rgba(255,255,255,.16);background:transparent;color:#c7cbd6;transition:all .15s}
.simChip:hover{border-color:rgba(255,255,255,.4);color:#fff}
.simChip[aria-pressed="true"]{background:#fff;border-color:#fff;color:#0b0d12;font-weight:750}
.simChip.rec{border-color:#2997ff}
.simChip.rec[aria-pressed="true"]{box-shadow:0 0 0 1px #2997ff}
.recBadge{display:inline-block;background:#2997ff;color:#fff;font-size:9px;font-weight:800;padding:2px 6px;border-radius:999px;margin-right:6px;letter-spacing:.02em;vertical-align:2px}

/* ---------- back ---------- */
.back{display:inline-flex;align-items:center;gap:5px;border:0;background:none;color:var(--accent);font-size:13px;font-weight:800;padding:0;margin-bottom:16px}
.back svg{width:14px;height:14px}

/* ---------- price ---------- */
.tabs{display:flex;gap:8px;overflow:auto;padding-bottom:2px}
.tab{white-space:nowrap;border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:9px 13px;font-size:12.5px;font-weight:800}
.tab.active{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.pricebar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:14px}
.sortbtn{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:7px 11px;font-size:11.5px;font-weight:750;color:var(--muted)}
.sortbtn svg{width:12px;height:12px}
.lensrow{display:flex;gap:12px;align-items:center;border:1px solid var(--line);border-radius:var(--radius-md);padding:14px;background:var(--surface);margin-top:10px}
.lensrow .info{flex:1;min-width:0}
.lensrow .info .name{display:flex;align-items:center;gap:6px;font-weight:800;font-size:14.5px}
.lensrow .info .desc{font-size:12.5px;color:var(--muted);margin-top:5px;line-height:1.6}
.lensrow .price{margin-top:8px;display:inline-flex;padding:4px 8px;border-radius:999px;background:var(--accent-soft);color:var(--accent-strong);font-weight:800;font-size:11.5px}
.gbadge{display:inline-flex;align-items:center;gap:4px;background:var(--gold-soft);color:var(--gold);border-radius:999px;padding:2px 7px;font-size:10px;font-weight:800}
.wishbtn{flex:none;width:38px;height:38px;border-radius:12px;border:1px solid var(--line);background:var(--surface);display:flex;align-items:center;justify-content:center;color:var(--muted-2)}
.wishbtn svg{width:17px;height:17px}
.wishbtn.on{color:var(--danger);border-color:color-mix(in srgb,var(--danger) 35%,var(--line))}
.wishbtn.on svg{fill:var(--danger)}
.priceNote{font-size:11.5px;color:var(--muted-2);line-height:1.6;margin-top:12px}

/* ---------- real brand price table (progressive) ---------- */
.priceSeries{margin-top:20px}
.priceSeries:first-child{margin-top:0}
.priceSeries-brand{font-size:10.5px;color:var(--muted-2);font-weight:700}
.priceSeries-name{font-size:15.5px;font-weight:800;margin-top:2px;letter-spacing:-.2px}
.priceTable{margin-top:10px;border:1px solid var(--line);border-radius:var(--radius-md);overflow:hidden;background:var(--surface)}
.priceTable-head{display:flex;align-items:center;gap:8px;padding:9px 14px;background:var(--surface-2)}
.priceTable-head span{font-size:10.5px;font-weight:700;color:var(--muted)}
