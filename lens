    simGb.setAttribute('aria-expanded',String(open));simGb.textContent=open?'닫기':'도수를 모르겠어요';
  });
  pwrR.addEventListener('input',function(){simSt.power=+pwrR.value/100;simSt.ri=recommendRatio(simSt.power);renderRiChips();simDraw();});
}

