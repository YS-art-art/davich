  document.querySelectorAll('.tab').forEach(function(t){ t.classList.toggle('active', t.textContent === ({single:'단초점',functional:'기능성',progressive:'누진다초점'})[d.cat]); });
  renderPriceList();
}
function toggleResultSave(){
  var d = resultData[currentResultType];
  if(!d) return;
  toggleWish(currentResultId, d.title, d.price.replace(/^보통 약 /,'').replace(/\\.$/,''));
}
function syncResultSaveBtn(){
  var btn = document.getElementById('rSaveBtn');
  if(!btn || !currentResultId) return;
  btn.classList.toggle('on', isWished(currentResultId));
}
function shareResult(){
  var d = resultData[currentResultType];
  if(!d) return;
  var text = '[다비치 렌즈 진단 결과] '+d.title+' — '+d.reason;
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(text).then(function(){ toast('결과가 클립보드에 복사됐어요'); }).catch(function(){ toast('결과: '+d.title); });
  }else{
    toast('결과: '+d.title);
  }
}

