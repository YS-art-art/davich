  {k:'correction', label:'교정 상태', bad:'정확한 처방으로 다시 맞춰볼 시점일 수 있어요', good:'지금 도수가 잘 맞는 편이에요'},
  {k:'comfort', label:'눈 편안함', bad:'눈이 자주 피곤하다면 블루라이트 차단이 도움될 수 있어요', good:'오래 봐도 눈이 편안한 편이에요'},
  {k:'lifestyle', label:'생활 환경', bad:'가까운 화면·글씨를 많이 보는 편이네요', good:'거리별로 고르게 사용하는 편이에요'}
];
function computeScores(answers, type){
  var s={distance:4, near:4, correction:4, comfort:4, lifestyle:4};
  answers.forEach(function(a){
    if(a==='distance'){ s.distance=2; }
    if(a==='near'){ s.near=2; s.lifestyle=Math.min(s.lifestyle,3); }
    if(a==='digital'){ s.comfort=2; s.lifestyle=Math.min(s.lifestyle,2); }
    if(a==='sun'){ s.lifestyle=Math.min(s.lifestyle,3); }
    if(a==='thin'){ s.correction=3; }
    if(a==='child'){ s.correction=2; s.distance=Math.min(s.distance,3); }
  });
  if(type==='child') s.correction=1;
  return s;
}
function renderScores(scores){
  document.getElementById('scoreBars').innerHTML = SCORE_AXES.map(function(a){
    var v=scores[a.k];
    var msg = v<=2 ? a.bad : a.good;
    return '<div class="scoreitem"><div class="top"><b>'+a.label+'</b><span>'+v+' / 5</span></div>'+
      '<div class="track"><i style="width:'+(v/5*100)+'%"></i></div>'+
      '<p>'+msg+'</p></div>';
  }).join('');
}

