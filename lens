function eyeRayPair(fx, color, op){
  var yR = 68+32*140/(fx-128), yRb = 200-yR;
  var s='';
  s+='<path d="M 30 68 L 128 68 L '+Math.min(fx,268)+' '+(fx<268?100:(68+(100-68)*(268-128)/(fx-128)))+
     (fx<268?' L 268 '+yR.toFixed(1):'')+'" fill="none" style="stroke:'+color+'" stroke-width="2" opacity="'+op+'"/>';
  s+='<path d="M 30 132 L 128 132 L '+Math.min(fx,268)+' '+(fx<268?100:(132-(132-100)*(268-128)/(fx-128)))+
     (fx<268?' L 268 '+yRb.toFixed(1):'')+'" fill="none" style="stroke:'+color+'" stroke-width="2" opacity="'+op+'"/>';
  if(fx<268){
    s+='<circle cx="'+fx+'" cy="100" r="3.6" style="fill:'+color+'" opacity="'+op+'"/>';
  }else{
    s+='<path d="M 268 '+(68+(100-68)*(268-128)/(fx-128)).toFixed(1)+' L '+fx+' 100" fill="none" style="stroke:'+color+'" stroke-width="1.4" stroke-dasharray="4 4" opacity=".5"/>';
    s+='<path d="M 268 '+(132-(132-100)*(268-128)/(fx-128)).toFixed(1)+' L '+fx+' 100" fill="none" style="stroke:'+color+'" stroke-width="1.4" stroke-dasharray="4 4" opacity=".5"/>';
    s+='<circle cx="'+fx+'" cy="100" r="3.6" fill="none" style="stroke:'+color+'" stroke-width="1.7" opacity=".7"/>';
  }
  return s;
}
