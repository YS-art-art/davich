/* 굴절률이 높을수록 렌즈 단면(위쪽 곡률)이 납작해지는 것을 아치 높이로 표현 */
var RATIO_THICKNESS = {'1.50':7.5,'1.56':6.5,'1.60':5.2,'1.67':4,'1.74':3};
function ratioIcon(v){
  var t = RATIO_THICKNESS[String(v).trim()] || 5;
  var bh = Math.max(1, t*0.18);
  return '<svg class="ratioIco" viewBox="0 0 28 16" xmlns="http://www.w3.org/2000/svg"><path d="M2 11 Q14 '+(11-t)+' 26 11 Q14 '+(11-bh)+' 2 11 Z" fill="currentColor"/></svg>';
}
function ratioCell(r){
  if(!r || (Array.isArray(r) && !r.length)) return '<span class="noRatio">&ndash;</span>';
  var vals = Array.isArray(r) ? r : [r];
  return vals.map(function(v){
    return '<span class="ratioLine">'+ratioIcon(v)+'<b>'+v+'</b></span>';
  }).join('');
}

